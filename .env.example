# Toggl Track MCP server environment.
#
# Copy this to a private location outside the repository, for example
# ~/.config/toggl-track-mcp/env, run `chmod 600` on it, and pass it with
# `docker run --env-file ...` or `uv run --env-file ...`. Never commit the real file.

# API token from https://track.toggl.com/profile
TOGGL_API_TOKEN=your_api_token_here

# Set to true to expose only read-only tools (no starting/stopping timers or creating tasks).
# TOGGL_READ_ONLY=true

# Override the timezone from your Toggl profile (IANA name).
# TOGGL_TIMEZONE=Europe/Helsinki

# Seconds to cache workspaces, projects and clients (default 900).
# TOGGL_CACHE_TTL=900
